[Unit]
Description=Refresh the Garmin dashboard and publish it to the home hub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bassbudget
Group=bassbudget
Environment=HOME=/var/lib/bassbudget
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/var/lib/bassbudget/garmin
ExecStart=/bin/bash /var/lib/bassbudget/garmin/refresh.sh
TimeoutStartSec=600
UMask=0007

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/bassbudget
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
